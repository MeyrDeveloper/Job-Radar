{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Bun: run app",
      "type": "shell",
      "dependsOn": ["Bun:run frontend", "Bun: run api", "Bun: run worker"]
    },
    {
      "label": "Bun:run frontend",
      "type": "shell",
      "command": "bun run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      }
    },
    {
      "label": "Bun: run api",
      "type": "shell",
      "command": "bun run start:api:dev",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      }
    },
    {
      "label": "Bun: run worker",
      "type": "shell",
      "command": "bun run start:worker:dev",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      }
    }
  ]
}
