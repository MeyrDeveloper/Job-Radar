{
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": ["vitest/globals", "node"],
    "paths": {
      "@app/database": ["./libs/database/src/index.ts"],
      "@app/database/*": ["./libs/database/src/*"],
      "@app/kafka": ["./libs/kafka/src/index.ts"],
      "@app/kafka/*": ["./libs/kafka/src/*"],
      "@app/shared": ["./libs/shared/src/index.ts"],
      "@app/shared/*": ["./libs/shared/src/*"]
    }
  },
  "files": [],
  "references": [
    {
      "path": "./apps/worker/tsconfig.app.json"
    },
    {
      "path": "./apps/api/tsconfig.app.json"
    },
    {
      "path": "./libs/kafka/tsconfig.lib.json"
    },
    {
      "path": "./libs/database/tsconfig.lib.json"
    },
    {
      "path": "./libs/shared/tsconfig.lib.json"
    }
  ]
}
